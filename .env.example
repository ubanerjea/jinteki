# Copy this file to .env and fill in the values below.
# .env is gitignored and must never be committed.

# --- Postgres (used by docker-compose.yml AND by DATABASE_URL below — keep them in sync) ---
POSTGRES_USER=jinteki
POSTGRES_PASSWORD=jinteki_dev_password
POSTGRES_DB=jinteki

# Prisma connection string. Host/port assumes `docker compose up -d` is running the
# postgres service from docker-compose.yml on localhost:5432.
DATABASE_URL="postgresql://jinteki:jinteki_dev_password@localhost:5432/jinteki?schema=public"

# --- Auth.js (next-auth@beta / v5) ---
# Secret used to sign/encrypt session data. Generate a real one with:
#   npx auth secret
# or:
#   openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth app credentials (Auth.js v5 auto-detects these exact env var names for
# a provider registered as `GitHub` with no explicit clientId/clientSecret — the
# convention is AUTH_<PROVIDERID>_ID / AUTH_<PROVIDERID>_SECRET).
#
# How to obtain them (manual, one-time, done by a human with a GitHub account):
#   1. Go to GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App.
#   2. Homepage URL: http://localhost:3000
#   3. Authorization callback URL: http://localhost:3000/api/auth/callback/github
#   4. Create the app, then generate a new client secret.
#   5. Paste the Client ID and Client Secret below.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Required for admin-gated routes to work under `next start` (production mode),
# local-only deployment. @auth/core's `trustHost` defaults to
# `NODE_ENV !== "production"` when neither AUTH_URL nor AUTH_TRUST_HOST is set -
# which means it's `true` under `next dev` (NODE_ENV=development) but silently
# `false` under `next start` (NODE_ENV=production), even on plain localhost
# HTTP with no real reverse proxy involved. With trustHost false, `auth()`
# fails to resolve the session at all - real database sessions read back as
# "not authenticated" even with a valid, unexpired Session row and the correct
# cookie sent. Found during Phase 3 verification (the first time an
# authenticated admin route was exercised against a genuine `next start`
# server rather than `next dev`) - see agent-reports/phase-3.md. Setting this
# to `true` restores the same behavior `next dev` already had; if this app is
# ever deployed behind a real reverse proxy for a non-local host, prefer
# setting AUTH_URL to the real public URL instead (see Auth.js docs) rather
# than blanket-trusting an arbitrary Host header.
AUTH_TRUST_HOST=true

# --- Remote access deployment (Phase 9) — a SECOND, separate set of env values ---
# See plans/design/REMOTE_ACCESS_DESIGN.md for the full reasoning; this comment only
# summarizes what changes if/when this codebase is also run as a Tailscale Funnel
# deployment reachable from outside localhost (e.g. under a swapped-in `.env.remote`,
# however the owner chooses to keep the two sets of values apart — this is NOT a
# second app or a second `.env.example` block that gets uncommented, it describes
# values that live in a wholly separate env file for the Funnel-facing process).
#
# For that deployment only (the plain localhost dev setup above is untouched):
#   - AUTH_GITHUB_ID / AUTH_GITHUB_SECRET: credentials from a SECOND GitHub OAuth App
#     (Settings -> Developer settings -> OAuth Apps -> New OAuth App), homepage and
#     callback URL both set to the Funnel URL (callback:
#     https://<host>.<tailnet-name>.ts.net/api/auth/callback/github). Do not reuse the
#     localhost dev app's credentials above — this must be a second, separate app.
#   - AUTH_URL: set to the Funnel URL itself (https://<host>.<tailnet-name>.ts.net).
#   - AUTH_SECRET: a fresh value from `npx auth secret` — do NOT reuse the local dev
#     secret above.
#   - AUTH_TRUST_HOST: remove/unset it for this deployment. AUTH_URL being set makes
#     it unnecessary, and per this file's own AUTH_TRUST_HOST comment above,
#     blanket-trusting the Host header is the wrong choice once a real public
#     hostname is in play.
#
# DATABASE_URL and Postgres itself are unchanged for this deployment — Tailscale
# Funnel only exposes port 3000 (the Next.js app), not 5432; Postgres stays bound to
# localhost, reached only by the Next.js server process on the same machine.
#
# Sign-in itself is additionally gated by the AllowedLogin table (see
# prisma/schema.prisma and auth.ts's signIn callback) — a real GitHub OAuth login
# still is not enough to get a session unless that GitHub username is present and
# active in AllowedLogin, managed via the /admin/allowlist UI.
