# Copy this file to .env.remote and fill in the values below.
# .env.remote is gitignored and must never be committed.
#
# This is the env file for the Funnel-facing remote process only
# (`pnpm start:remote`, port 3001) - see plans/design/REMOTE_ACCESS_DESIGN.md
# for the full "why Tailscale Funnel + an application-layer allowlist"
# reasoning, and plans/PHASE_9_PLAN.md §4 for why this file is
# self-contained (every value a full process needs, not a partial override
# layered on top of the plain `.env` used by `pnpm dev`) and why
# AUTH_TRUST_HOST must be set to an explicitly empty value below rather than
# omitted.
#
# Local dev (`pnpm dev`, port 3000, plain `.env`) is completely unaffected by
# this file and keeps running exactly as it does today - the two processes
# are designed to run simultaneously, never a swap-before-start.

# --- Postgres / Prisma ---
# Same shared Postgres instance as local dev (Tailscale Funnel only exposes
# the Next.js port, not 5432 - Postgres stays bound to localhost, reached
# only by the Next.js server process on this machine). Included here anyway
# (identical value to .env) so this file never depends on .env's contents at
# all - one file, fully describing one process, no merge order to reason
# about.
DATABASE_URL="postgresql://jinteki:jinteki_dev_password@localhost:5432/jinteki?schema=public"

# --- Auth.js (next-auth@beta / v5) ---
# Credentials from a SECOND, separate GitHub OAuth App (Settings -> Developer
# settings -> OAuth Apps -> New OAuth App), homepage and callback URL both
# set to the Funnel URL (callback:
# https://<host>.<tailnet-name>.ts.net/api/auth/callback/github). Do NOT
# reuse the local dev app's credentials from .env.example - this must be a
# second, separate app (plans/PHASE_9_PLAN.md §6).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Set to the Funnel URL itself (the real public https://<host>.<tailnet-name>.ts.net
# address), not localhost - this is the remote-facing process.
AUTH_URL=https://<host>.<tailnet-name>.ts.net

# A fresh value from `npx auth secret` - do NOT reuse the local dev secret
# from .env.
AUTH_SECRET=

# Deliberately set to an EMPTY value here, not omitted. Next.js's own env
# loader (@next/env) reads .env from disk unconditionally on every start,
# regardless of what this file already put in process.env - but a key
# already present in process.env wins over whatever .env says for that same
# key. If AUTH_TRUST_HOST were simply left out of this file, next start's
# loader would still pick up AUTH_TRUST_HOST=true from the local .env file
# sitting in the same directory, silently reintroducing the "trust any Host
# header" problem AUTH_URL exists to replace - on the one process where it
# matters most (the Funnel-facing one, genuinely reachable from the public
# internet). Setting it to empty here closes that gap before Next's loader
# ever runs. See plans/PHASE_9_PLAN.md §4 for the full landmine writeup.
AUTH_TRUST_HOST=

# Sign-in itself is additionally gated by the AllowedLogin table (see
# prisma/schema.prisma and auth.ts's signIn callback) - a real GitHub OAuth
# login still is not enough to get a session unless that GitHub username is
# present and active in AllowedLogin, managed via the /admin/allowlist UI.
